# Gaussian Naive Bayes with dataset and evaluation

from sklearn.naive_bayes import GaussianNB

from sklearn.metrics import confusion_matrix, accuracy_score

 

X = [[1, 20], [2, 22], [3, 25], [6, 60], [7, 65], [8, 70]]

y = ['Low', 'Low', 'Low', 'High', 'High', 'High']

 

model = GaussianNB()

model.fit(X, y)

pred = model.predict(X)

 

print("Dataset:", X)

print("Actual Labels:", y)

print("Predicted Labels:", pred.tolist())

print("Confusion Matrix:")

print(confusion_matrix(y, pred, labels=['Low', 'High']))

print("Accuracy:", accuracy_score(y, pred) * 100, "%")
